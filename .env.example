# TOKO SAKALA — Environment Configuration Example
# Salin file ini menjadi .env atau .env.local untuk mengaktifkan integrasi lokal

# ==============================================================================
# 1. Supabase Cloud Sync (PostgreSQL Rp0 Free Tier)
# ==============================================================================
# Diperoleh dari Supabase Dashboard -> Project Settings -> API
# VITE_SUPABASE_URL: URL API REST proyek Supabase Anda (mis: https://xyz.supabase.co)
# VITE_SUPABASE_ANON_KEY: Kunci publik anonim (aman di sisi browser dengan Row Level Security)
# VITE_SUPABASE_API_TOKEN: Token opsional untuk keperluan skrip migrasi/backup CLI (JANGAN di-commit!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_API_TOKEN=

# ==============================================================================
# 2. Google Identity Services (GIS) OAuth 2.0 Web Client ID (Cadangan Manual)
# ==============================================================================
# Diperoleh dari Google Cloud Console -> APIs & Services -> Credentials
# Masukkan domain origin ke dalam Authorized JavaScript origins (mis: http://localhost:3000)
# Scope minimum: https://www.googleapis.com/auth/drive.file
# JANGAN PERNAH menaruh Client Secret atau token privat di frontend!
VITE_GOOGLE_CLIENT_ID=
