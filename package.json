{
  "name": "toko-sakala-ai-studio-starter",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "TOKO SAKALA — React starter yang disesuaikan untuk Google AI Studio Build; Asisten AI nonaktif secara default.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:local": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
